#!/bin/bash
# Double-click: pull a few CME 10-minute files from Box, keep only channel 310 (ES).
# Output: data.nosync/raw/<day>/ next to this file (never committed, never synced to iCloud).
# Needs rclone with a remote named "box" that can read the course capture folder.
# Re-running skips files that are already done.
cd "$(dirname "$0")"
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
command -v rclone >/dev/null || { echo "rclone missing: brew install rclone, then rclone config (remote name: box)."; read; exit 1; }
VENV="../.venv.nosync"                       # shared env of the original workspace, if present
[ -d "$VENV" ] || VENV=".venv.nosync"
[ -x "$VENV/bin/python" ] || python3 -m venv "$VENV"
"$VENV/bin/pip" install -q zstandard || exit 1

# Dev set (already fetched; skipped automatically): 2/2 Sunday open, 3/27 open 30 min
STAMPS="20250202T230000 20250327T133000 20250327T134000 20250327T135000"
# 3/27 rest of regular session (09:00-15:15 CT): 38 files
STAMPS="$STAMPS 20250327T140000 20250327T141000 20250327T142000 20250327T143000 20250327T144000 20250327T145000 20250327T150000 20250327T151000 20250327T152000 20250327T153000 20250327T154000 20250327T155000 20250327T160000 20250327T161000 20250327T162000 20250327T163000 20250327T164000 20250327T165000 20250327T170000 20250327T171000 20250327T172000 20250327T173000 20250327T174000 20250327T175000 20250327T180000 20250327T181000 20250327T182000 20250327T183000 20250327T184000 20250327T185000 20250327T190000 20250327T191000 20250327T192000 20250327T193000 20250327T194000 20250327T195000 20250327T200000 20250327T201000"
# 4/7 stress, open 2h: 12 files
STAMPS="$STAMPS 20250407T133000 20250407T134000 20250407T135000 20250407T140000 20250407T141000 20250407T142000 20250407T143000 20250407T144000 20250407T145000 20250407T150000 20250407T151000 20250407T152000"
# 4/10 stress, open 2h: 12 files
STAMPS="$STAMPS 20250410T133000 20250410T134000 20250410T135000 20250410T140000 20250410T141000 20250410T142000 20250410T143000 20250410T144000 20250410T145000 20250410T150000 20250410T151000 20250410T152000"
# 2/11 normal open 1h (CST: 08:30 CT = 14:30 UTC): 6 files
STAMPS="$STAMPS 20250211T143000 20250211T144000 20250211T145000 20250211T150000 20250211T151000 20250211T152000"
# 3/13 normal open 1h: 6 files
STAMPS="$STAMPS 20250313T133000 20250313T134000 20250313T135000 20250313T140000 20250313T141000 20250313T142000"
# 4/23 normal open 1h: 6 files
STAMPS="$STAMPS 20250423T133000 20250423T134000 20250423T135000 20250423T140000 20250423T141000 20250423T142000"

caffeinate -i -s -w $$ &
echo ">> Fetching: $STAMPS"
"$VENV/bin/python" tools/fetch_es.py $STAMPS --workers 2
echo ">> Finished. You can close this window."
